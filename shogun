<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>オットセイ将軍｜指定医薬部外品</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;700;900&family=Shippori+Mincho:wght@400;700;800&family=Zen+Antique+Soft&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --gold: #C5A355;
  --gold-light: #E8D5A0;
  --gold-dark: #8B7332;
  --black: #0A0A0A;
  --black-soft: #1A1A1A;
  --black-card: #141414;
  --red: #8B1A1A;
  --red-bright: #C43333;
  --white: #F5F0E8;
  --white-dim: #D4CFC5;
  --gray: #888;
  --font-display: 'Zen Antique Soft', serif;
  --font-body: 'Shippori Mincho', serif;
  --font-accent: 'Noto Serif JP', serif;
}

html { scroll-behavior: smooth; font-size: 16px; }

body {
  font-family: var(--font-body);
  background: var(--black);
  color: var(--white);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ===== UTILITY ===== */
.container { max-width: 960px; margin: 0 auto; padding: 0 24px; }
.text-gold { color: var(--gold); }
.text-red { color: var(--red-bright); }

/* ===== NOISE OVERLAY ===== */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 9999;
}

/* ===== FLOATING PARTICLES ===== */
.particles {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}
.particle {
  position: absolute;
  width: 2px;
  height: 2px;
  background: var(--gold);
  border-radius: 50%;
  opacity: 0;
  animation: particleFloat 8s infinite;
}
@keyframes particleFloat {
  0% { opacity: 0; transform: translateY(100vh) scale(0); }
  20% { opacity: 0.6; }
  80% { opacity: 0.3; }
  100% { opacity: 0; transform: translateY(-20vh) scale(1); }
}

/* ===== SECTION COMMON ===== */
section {
  position: relative;
  z-index: 1;
}
.section-divider {
  width: 80px;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  margin: 0 auto 40px;
}
.section-label {
  font-family: var(--font-accent);
  font-size: 0.7rem;
  letter-spacing: 0.35em;
  color: var(--gold);
  text-transform: uppercase;
  text-align: center;
  margin-bottom: 16px;
  opacity: 0.7;
}

/* ===== 1. FIRST VIEW (FV) ===== */
.fv {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
  overflow: hidden;
  padding: 60px 24px;
}
.fv::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 40% at 50% 30%, rgba(197,163,85,0.08) 0%, transparent 70%),
    radial-gradient(ellipse 80% 60% at 50% 100%, rgba(139,26,26,0.12) 0%, transparent 60%);
  pointer-events: none;
}
.fv::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(197,163,85,0.04) 0%, transparent 70%);
  pointer-events: none;
}

/* Mon (Crest) */
.mon {
  width: 90px;
  height: 90px;
  border: 2px solid var(--gold);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32px;
  position: relative;
  animation: monPulse 3s ease-in-out infinite;
}
.mon::before {
  content: '将';
  font-family: var(--font-display);
  font-size: 2.4rem;
  color: var(--gold);
}
.mon::after {
  content: '';
  position: absolute;
  inset: -6px;
  border: 1px solid rgba(197,163,85,0.3);
  border-radius: 50%;
}
@keyframes monPulse {
  0%, 100% { box-shadow: 0 0 20px rgba(197,163,85,0.1); }
  50% { box-shadow: 0 0 40px rgba(197,163,85,0.25); }
}

.badge-pharma {
  display: inline-block;
  border: 1px solid var(--gold);
  padding: 6px 20px;
  font-family: var(--font-accent);
  font-size: 0.72rem;
  letter-spacing: 0.25em;
  color: var(--gold);
  margin-bottom: 36px;
  position: relative;
}
.badge-pharma::before,
.badge-pharma::after {
  content: '◆';
  font-size: 0.45rem;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  color: var(--gold);
}
.badge-pharma::before { left: 6px; }
.badge-pharma::after { right: 6px; }

.fv-title {
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 7vw, 5rem);
  line-height: 1.25;
  letter-spacing: 0.08em;
  color: var(--white);
  margin-bottom: 12px;
  text-shadow: 0 0 60px rgba(197,163,85,0.15);
}
.fv-title .em {
  color: var(--gold);
  display: inline-block;
  position: relative;
}
.fv-title .em::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}

.fv-sub {
  font-family: var(--font-display);
  font-size: clamp(1.2rem, 3vw, 1.8rem);
  color: var(--gold-light);
  letter-spacing: 0.15em;
  margin-bottom: 40px;
  opacity: 0.9;
}

.fv-benefits {
  display: flex;
  gap: 32px;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 48px;
}
.fv-benefit {
  font-family: var(--font-accent);
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  color: var(--white-dim);
  padding: 0 16px;
  border-left: 1px solid var(--gold-dark);
}
.fv-benefit:first-child { border-left: none; }

.fv-scroll {
  font-size: 0.7rem;
  letter-spacing: 0.3em;
  color: var(--gold-dark);
  margin-top: 24px;
  animation: scrollBounce 2s ease-in-out infinite;
}
.fv-scroll::after {
  content: '';
  display: block;
  width: 1px;
  height: 40px;
  background: linear-gradient(180deg, var(--gold-dark), transparent);
  margin: 12px auto 0;
}
@keyframes scrollBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(8px); }
}

/* ===== 2. PAIN ===== */
.pain {
  padding: 100px 0;
  background: linear-gradient(180deg, var(--black) 0%, var(--black-soft) 50%, var(--black) 100%);
}
.pain-headline {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 4vw, 2.4rem);
  text-align: center;
  line-height: 1.7;
  margin-bottom: 60px;
  color: var(--white);
}
.pain-headline .line {
  display: block;
}
.pain-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
  margin-bottom: 60px;
}
.pain-card {
  background: var(--black-card);
  border: 1px solid rgba(197,163,85,0.12);
  padding: 32px 28px;
  position: relative;
  transition: border-color 0.4s, transform 0.3s;
}
.pain-card:hover {
  border-color: rgba(197,163,85,0.35);
  transform: translateY(-2px);
}
.pain-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 3px;
  height: 100%;
  background: var(--red);
  opacity: 0.6;
}
.pain-card .icon {
  font-size: 1.6rem;
  margin-bottom: 16px;
  display: block;
}
.pain-card h3 {
  font-family: var(--font-accent);
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 10px;
  color: var(--white);
}
.pain-card p {
  font-size: 0.88rem;
  line-height: 1.8;
  color: var(--white-dim);
  opacity: 0.8;
}

.pain-bottom {
  text-align: center;
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2.5vw, 1.5rem);
  color: var(--gold-light);
  line-height: 2;
  padding-top: 20px;
  border-top: 1px solid rgba(197,163,85,0.15);
  max-width: 600px;
  margin: 0 auto;
}

/* ===== 3. SOLUTION ===== */
.solution {
  padding: 100px 0;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.solution::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 1px;
  height: 80px;
  background: linear-gradient(180deg, transparent, var(--gold));
}

.solution-shout {
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 6vw, 4rem);
  letter-spacing: 0.12em;
  color: var(--gold);
  margin-bottom: 16px;
  margin-top: 40px;
  text-shadow: 0 0 40px rgba(197,163,85,0.2);
  position: relative;
  display: inline-block;
}
.solution-shout::before,
.solution-shout::after {
  content: '―';
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  color: var(--gold-dark);
  font-size: 0.5em;
}
.solution-shout::before { left: -1.5em; }
.solution-shout::after { right: -1.5em; }

.solution-sub {
  font-family: var(--font-display);
  font-size: 1.2rem;
  color: var(--white-dim);
  letter-spacing: 0.2em;
  margin-bottom: 64px;
}

.advantage-box {
  background: linear-gradient(135deg, var(--black-card) 0%, rgba(139,26,26,0.08) 100%);
  border: 1px solid rgba(197,163,85,0.2);
  padding: 48px 40px;
  max-width: 720px;
  margin: 0 auto 40px;
  text-align: left;
  position: relative;
}
.advantage-box::before {
  content: '医薬部外品';
  position: absolute;
  top: -12px;
  left: 32px;
  background: var(--black);
  padding: 4px 16px;
  font-family: var(--font-accent);
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  color: var(--gold);
  border: 1px solid var(--gold-dark);
}
.advantage-box h3 {
  font-family: var(--font-display);
  font-size: 1.4rem;
  color: var(--gold);
  margin-bottom: 20px;
  letter-spacing: 0.05em;
}
.advantage-box p {
  font-size: 0.92rem;
  line-height: 2;
  color: var(--white-dim);
  margin-bottom: 16px;
}

.vs-table {
  width: 100%;
  max-width: 640px;
  margin: 0 auto;
  border-collapse: collapse;
  font-size: 0.88rem;
}
.vs-table th {
  font-family: var(--font-accent);
  font-weight: 700;
  padding: 16px 12px;
  text-align: center;
  border-bottom: 2px solid var(--gold-dark);
  letter-spacing: 0.1em;
  color: var(--gold-light);
  font-size: 0.8rem;
}
.vs-table td {
  padding: 14px 12px;
  text-align: center;
  border-bottom: 1px solid rgba(197,163,85,0.1);
  color: var(--white-dim);
}
.vs-table tr td:first-child {
  text-align: left;
  font-weight: 700;
  color: var(--white);
}
.vs-table .highlight {
  color: var(--gold);
  font-weight: 700;
}

/* ===== 4. REASON (成分) ===== */
.reason {
  padding: 100px 0;
  background: linear-gradient(180deg, var(--black) 0%, var(--black-soft) 100%);
}
.reason-hero {
  text-align: center;
  margin-bottom: 64px;
}
.reason-hero h2 {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 4vw, 2.6rem);
  color: var(--white);
  margin-bottom: 8px;
  letter-spacing: 0.06em;
}
.reason-hero .en {
  font-family: var(--font-accent);
  font-size: 0.72rem;
  letter-spacing: 0.3em;
  color: var(--gold-dark);
}

.ingredient-main {
  background: var(--black-card);
  border: 1px solid rgba(197,163,85,0.2);
  padding: 48px 40px;
  margin-bottom: 40px;
  position: relative;
  overflow: hidden;
}
.ingredient-main::after {
  content: '';
  position: absolute;
  top: -40px;
  right: -40px;
  width: 200px;
  height: 200px;
  background: radial-gradient(circle, rgba(197,163,85,0.06) 0%, transparent 70%);
  pointer-events: none;
}
.ingredient-main .tag {
  display: inline-block;
  background: var(--gold);
  color: var(--black);
  font-family: var(--font-accent);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  padding: 4px 14px;
  margin-bottom: 20px;
}
.ingredient-main h3 {
  font-family: var(--font-display);
  font-size: 1.6rem;
  color: var(--gold);
  margin-bottom: 8px;
}
.ingredient-main .latin {
  font-family: var(--font-accent);
  font-size: 0.78rem;
  color: var(--gold-dark);
  letter-spacing: 0.1em;
  margin-bottom: 20px;
  display: block;
}
.ingredient-main p {
  font-size: 0.92rem;
  line-height: 2;
  color: var(--white-dim);
  margin-bottom: 14px;
}

.ingredient-sub-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
}
.ingredient-sub {
  background: var(--black-card);
  border: 1px solid rgba(197,163,85,0.1);
  padding: 28px 24px;
  text-align: center;
  transition: border-color 0.3s;
}
.ingredient-sub:hover {
  border-color: rgba(197,163,85,0.3);
}
.ingredient-sub .ing-icon {
  font-size: 1.8rem;
  margin-bottom: 12px;
  display: block;
}
.ingredient-sub h4 {
  font-family: var(--font-accent);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--white);
  margin-bottom: 8px;
}
.ingredient-sub p {
  font-size: 0.8rem;
  line-height: 1.7;
  color: var(--white-dim);
  opacity: 0.75;
}

/* ===== 5. SOCIAL PROOF ===== */
.proof {
  padding: 100px 0;
}
.review-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
  margin-bottom: 48px;
}
.review-card {
  background: var(--black-card);
  border: 1px solid rgba(197,163,85,0.1);
  padding: 36px 28px;
  position: relative;
}
.review-card::before {
  content: '"';
  font-family: var(--font-display);
  font-size: 4rem;
  color: var(--gold);
  opacity: 0.15;
  position: absolute;
  top: 8px;
  left: 16px;
  line-height: 1;
}
.review-card .stars {
  color: var(--gold);
  font-size: 0.8rem;
  letter-spacing: 0.15em;
  margin-bottom: 16px;
  display: block;
}
.review-card .review-text {
  font-size: 0.9rem;
  line-height: 1.9;
  color: var(--white-dim);
  margin-bottom: 20px;
  font-style: italic;
}
.review-card .reviewer {
  font-family: var(--font-accent);
  font-size: 0.78rem;
  color: var(--gold-dark);
  letter-spacing: 0.05em;
}
.review-card .reviewer span {
  display: block;
  color: var(--gray);
  font-size: 0.7rem;
  margin-top: 4px;
}

.proof-note {
  text-align: center;
  font-size: 0.72rem;
  color: var(--gray);
  letter-spacing: 0.05em;
}

/* ===== 6. OFFER (CTA) ===== */
.offer {
  padding: 100px 0 80px;
  text-align: center;
  position: relative;
}
.offer::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 70% 50% at 50% 60%, rgba(139,26,26,0.1) 0%, transparent 70%);
  pointer-events: none;
}

.offer-headline {
  font-family: var(--font-display);
  font-size: clamp(1.4rem, 3.5vw, 2.2rem);
  color: var(--white);
  margin-bottom: 48px;
  letter-spacing: 0.06em;
  line-height: 1.6;
}

.offer-box {
  background: linear-gradient(135deg, var(--black-card), rgba(197,163,85,0.05));
  border: 2px solid var(--gold-dark);
  max-width: 560px;
  margin: 0 auto 40px;
  padding: 48px 40px;
  position: relative;
}
.offer-box::before {
  content: '初陣特別価格';
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--gold);
  color: var(--black);
  font-family: var(--font-accent);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  padding: 5px 24px;
  white-space: nowrap;
}

.price-display {
  margin-bottom: 28px;
}
.price-original {
  font-size: 1rem;
  color: var(--gray);
  text-decoration: line-through;
  margin-bottom: 8px;
}
.price-current {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 6vw, 3.6rem);
  color: var(--gold);
  letter-spacing: 0.05em;
}
.price-current .yen {
  font-size: 0.5em;
  vertical-align: top;
  margin-right: 2px;
}
.price-current .tax {
  font-size: 0.35em;
  color: var(--white-dim);
  margin-left: 4px;
}
.price-sub {
  font-size: 0.82rem;
  color: var(--white-dim);
  margin-top: 4px;
}

.guarantee-list {
  list-style: none;
  margin-bottom: 32px;
  text-align: left;
  max-width: 340px;
  margin-left: auto;
  margin-right: auto;
}
.guarantee-list li {
  font-size: 0.85rem;
  color: var(--white-dim);
  padding: 8px 0;
  padding-left: 24px;
  position: relative;
  border-bottom: 1px solid rgba(197,163,85,0.08);
}
.guarantee-list li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--gold);
  font-weight: 700;
}

.cta-btn {
  display: inline-block;
  background: linear-gradient(135deg, var(--gold-dark), var(--gold), var(--gold-dark));
  background-size: 200% 100%;
  color: var(--black);
  font-family: var(--font-display);
  font-size: 1.2rem;
  letter-spacing: 0.15em;
  padding: 20px 56px;
  border: none;
  cursor: pointer;
  text-decoration: none;
  transition: background-position 0.5s, box-shadow 0.3s, transform 0.2s;
  position: relative;
  overflow: hidden;
}
.cta-btn:hover {
  background-position: 100% 0;
  box-shadow: 0 0 40px rgba(197,163,85,0.3);
  transform: translateY(-2px);
}
.cta-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  animation: ctaShine 3s ease-in-out infinite;
}
@keyframes ctaShine {
  0% { left: -100%; }
  50% { left: 100%; }
  100% { left: 100%; }
}

.cta-sub {
  font-size: 0.75rem;
  color: var(--gold-dark);
  margin-top: 16px;
  letter-spacing: 0.1em;
}

.guarantee-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid rgba(197,163,85,0.3);
  padding: 10px 24px;
  margin-top: 32px;
  font-family: var(--font-accent);
  font-size: 0.78rem;
  letter-spacing: 0.1em;
  color: var(--gold-light);
}
.guarantee-badge .shield {
  font-size: 1.2rem;
}

/* ===== FOOTER ===== */
.footer {
  padding: 48px 24px;
  text-align: center;
  border-top: 1px solid rgba(197,163,85,0.1);
}
.footer p {
  font-size: 0.7rem;
  color: var(--gray);
  line-height: 2;
  letter-spacing: 0.05em;
}
.footer .legal {
  max-width: 640px;
  margin: 0 auto;
}

/* ===== ANIMATIONS ===== */
.fade-in {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ===== RESPONSIVE ===== */
@media (max-width: 640px) {
  .fv { padding: 48px 20px; min-height: 100svh; }
  .fv-benefits { flex-direction: column; gap: 12px; align-items: center; }
  .fv-benefit { border-left: none; border-top: 1px solid var(--gold-dark); padding: 12px 0 0; }
  .fv-benefit:first-child { border-top: none; }
  .pain { padding: 72px 0; }
  .pain-grid { grid-template-columns: 1fr; }
  .advantage-box { padding: 36px 24px; }
  .offer-box { padding: 40px 24px; }
  .cta-btn { padding: 18px 36px; font-size: 1.05rem; }
  .solution-shout::before, .solution-shout::after { display: none; }
  .review-grid { grid-template-columns: 1fr; }
